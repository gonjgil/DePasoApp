@model NuevoEnvioViewModel
@{
    ViewData["Title"] = "Nuevo envío";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <h1>Nuevo envío</h1>
        <form asp-action="Nuevo" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="OrigenDir" class="form-label">Origen</label>
                    <input asp-for="OrigenDir" class="form-control" placeholder="Dirección de origen" />
                    <span asp-validation-for="OrigenDir" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DestinoDir" class="form-label">Destino</label>
                    <input asp-for="DestinoDir" class="form-control" placeholder="Dirección de destino" />
                    <span asp-validation-for="DestinoDir" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="OrigenLat" class="form-label">Latitud origen</label>
                    <input asp-for="OrigenLat" class="form-control" type="number" step="0.000001" />
                    <span asp-validation-for="OrigenLat" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="OrigenLng" class="form-label">Longitud origen</label>
                    <input asp-for="OrigenLng" class="form-control" type="number" step="0.000001" />
                    <span asp-validation-for="OrigenLng" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Tamanio" class="form-label">Tamaño</label>
                    <input asp-for="Tamanio" class="form-control" type="number" min="1" max="255" />
                    <span asp-validation-for="Tamanio" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DestinoLat" class="form-label">Latitud destino</label>
                    <input asp-for="DestinoLat" class="form-control" type="number" step="0.000001" />
                    <span asp-validation-for="DestinoLat" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DestinoLng" class="form-label">Longitud destino</label>
                    <input asp-for="DestinoLng" class="form-control" type="number" step="0.000001" />
                    <span asp-validation-for="DestinoLng" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="FechaLimite" class="form-label">Fecha límite</label>
                    <input asp-for="FechaLimite" class="form-control" type="date" />
                    <span asp-validation-for="FechaLimite" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PesoKg" class="form-label">Peso (kg)</label>
                    <input asp-for="PesoKg" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PesoKg" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Monto" class="form-label">Monto</label>
                    <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Ej. Paquetes de oficina" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar envío</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
