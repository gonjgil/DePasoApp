@model NuevoEnvioViewModel
@{
    ViewData["Title"] = "Nuevo envío";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <h1>Nuevo envío</h1>
        <form asp-action="Nuevo" method="post" novalidate data-url-calles="@Url.Action("SugerirCalles", "Envios")">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <fieldset class="col-12 col-md-6 mb-3">
                    <legend class="h5">Origen</legend>
                    <div class="row">
                        <div class="col-8 mb-3">
                            <label asp-for="OrigenCalle" class="form-label">Calle</label>
                            <input asp-for="OrigenCalle" class="form-control" maxlength="150" autocomplete="off" />
                            <div id="OrigenSugerencias" class="list-group mt-1"></div>
                            <div id="OrigenEstadoCalle" class="small text-muted" aria-live="polite"></div>
                            <span asp-validation-for="OrigenCalle" class="text-danger"></span>
                        </div>
                        <div class="col-4 mb-3">
                            <label asp-for="OrigenAltura" class="form-label">Altura</label>
                            <input asp-for="OrigenAltura" class="form-control" type="number" min="1" step="1" />
                            <span asp-validation-for="OrigenAltura" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="OrigenLocalidad" class="form-label">Localidad</label>
                            <input asp-for="OrigenLocalidad" class="form-control" maxlength="100" readonly />
                            <span asp-validation-for="OrigenLocalidad" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="OrigenProvincia" class="form-label">Provincia</label>
                            <input asp-for="OrigenProvincia" class="form-control" maxlength="100" readonly />
                            <span asp-validation-for="OrigenProvincia" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="OrigenPiso" class="form-label">Piso (opcional)</label>
                            <input asp-for="OrigenPiso" class="form-control" maxlength="10" />
                            <span asp-validation-for="OrigenPiso" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="OrigenDepartamento" class="form-label">Departamento (opcional)</label>
                            <input asp-for="OrigenDepartamento" class="form-control" maxlength="10" />
                            <span asp-validation-for="OrigenDepartamento" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="col-12 col-md-6 mb-3">
                    <legend class="h5">Destino</legend>
                    <div class="row">
                        <div class="col-8 mb-3">
                            <label asp-for="DestinoCalle" class="form-label">Calle</label>
                            <input asp-for="DestinoCalle" class="form-control" maxlength="150" autocomplete="off" />
                            <div id="DestinoSugerencias" class="list-group mt-1"></div>
                            <div id="DestinoEstadoCalle" class="small text-muted" aria-live="polite"></div>
                            <span asp-validation-for="DestinoCalle" class="text-danger"></span>
                        </div>
                        <div class="col-4 mb-3">
                            <label asp-for="DestinoAltura" class="form-label">Altura</label>
                            <input asp-for="DestinoAltura" class="form-control" type="number" min="1" step="1" />
                            <span asp-validation-for="DestinoAltura" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="DestinoLocalidad" class="form-label">Localidad</label>
                            <input asp-for="DestinoLocalidad" class="form-control" maxlength="100" readonly />
                            <span asp-validation-for="DestinoLocalidad" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="DestinoProvincia" class="form-label">Provincia</label>
                            <input asp-for="DestinoProvincia" class="form-control" maxlength="100" readonly />
                            <span asp-validation-for="DestinoProvincia" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="DestinoPiso" class="form-label">Piso (opcional)</label>
                            <input asp-for="DestinoPiso" class="form-control" maxlength="10" />
                            <span asp-validation-for="DestinoPiso" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="DestinoDepartamento" class="form-label">Departamento (opcional)</label>
                            <input asp-for="DestinoDepartamento" class="form-control" maxlength="10" />
                            <span asp-validation-for="DestinoDepartamento" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Tamanio" class="form-label">Tamaño</label>
                    <input asp-for="Tamanio" class="form-control" type="number" min="1" max="255" />
                    <span asp-validation-for="Tamanio" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="FechaLimite" class="form-label">Fecha límite</label>
                    <input asp-for="FechaLimite" class="form-control" type="date" />
                    <span asp-validation-for="FechaLimite" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PesoKg" class="form-label">Peso (kg)</label>
                    <input asp-for="PesoKg" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PesoKg" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Monto" class="form-label">Monto</label>
                    <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Ej. Paquetes de oficina" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar envío</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/autocompletar-calles.js" asp-append-version="true"></script>
}
