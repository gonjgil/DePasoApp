@model List<DePaso.Web.Models.EnvioApiResponse>
@using DePaso.Logica.enums
@{
    ViewData["Title"] = "Mis envíos";
}

<header class="page-header page-header-split">
    <div>
        <h1 class="page-title">Mis envíos</h1>
        <p class="page-subtitle">Consultá y administrá los envíos que cargaste.</p>
    </div>
    <a asp-action="Nuevo" class="btn btn-primary">
        <span class="dp-icon icon-plus" aria-hidden="true"></span> Nuevo envío
    </a>
</header>

@if (Model.Count == 0)
{
    <section class="surface shipments-empty">
        <span class="icon-tile"><span class="dp-icon icon-package" aria-hidden="true"></span></span>
        <h2 class="section-heading">Todavía no tenés envíos cargados</h2>
    </section>
}
else
{
    <div class="surface table-responsive shipments-surface">
        <table class="table align-middle shipments-table" role="table">
            <caption class="visually-hidden">Listado de mis envíos</caption>
            <thead role="rowgroup">
                <tr role="row">
                    <th role="columnheader" scope="col">Origen</th>
                    <th role="columnheader" scope="col">Destino</th>
                    <th role="columnheader" scope="col">Fecha límite</th>
                    <th role="columnheader" scope="col">Peso</th>
                    <th role="columnheader" scope="col">Monto</th>
                    <th role="columnheader" scope="col">Estado</th>
                    <th role="columnheader" scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                @foreach (var envio in Model)
                {
                    var claseEstado = (EstadoEnvio)envio.Estado switch
                    {
                        EstadoEnvio.BuscandoConductor => "dp-badge-buscando",
                        EstadoEnvio.ConductorAsignado or EstadoEnvio.Retirado or EstadoEnvio.EnCamino => "dp-badge-asignado",
                        EstadoEnvio.Entregado => "dp-badge-activo",
                        EstadoEnvio.Cancelado => "dp-badge-cancelado",
                        _ => ""
                    };
                    <tr role="row">
                        <td role="cell" class="shipment-route">
                            <span class="shipment-mobile-label" aria-hidden="true">Origen</span>
                            <span class="shipment-address">@envio.OrigenCalle @envio.OrigenAltura</span>
                            <span class="shipment-locality">@envio.OrigenLocalidad, @envio.OrigenProvincia</span>
                        </td>
                        <td role="cell" class="shipment-route">
                            <span class="shipment-mobile-label" aria-hidden="true">Destino</span>
                            <span class="shipment-address">@envio.DestinoCalle @envio.DestinoAltura</span>
                            <span class="shipment-locality">@envio.DestinoLocalidad, @envio.DestinoProvincia</span>
                        </td>
                        <td role="cell" class="shipment-meta"><span class="shipment-mobile-label" aria-hidden="true">Fecha límite</span>@envio.FechaLimite.ToString("dd/MM/yyyy")</td>
                        <td role="cell" class="shipment-meta"><span class="shipment-mobile-label" aria-hidden="true">Peso</span>@envio.PesoKg kg</td>
                        <td role="cell" class="shipment-meta"><span class="shipment-mobile-label" aria-hidden="true">Monto</span>$@envio.Monto</td>
                        <td role="cell" class="shipment-status"><span class="shipment-mobile-label" aria-hidden="true">Estado</span><span class="badge dp-badge @claseEstado">@EstadosEnvio.Texto(envio.Estado)</span></td>
                        <td role="cell" class="shipment-action-cell">
                            <div class="shipment-actions">
                                <a asp-action="Editar" asp-route-id="@envio.Id"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Borrar" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@envio.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Seguro que querés borrar este envío?');">Borrar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
