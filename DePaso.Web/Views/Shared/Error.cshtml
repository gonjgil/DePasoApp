@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="simple-page">
    <div class="surface">
        <span class="icon-tile"><span class="dp-icon icon-alert" aria-hidden="true"></span></span>
        <h1 class="page-title">Ocurrió un error</h1>
        <p class="page-subtitle">Hubo un problema al procesar tu solicitud.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mt-3 mb-0">
                <strong>Identificador de la solicitud</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="border-top mt-4 pt-3">
            <h2 class="section-heading mb-2">Modo de desarrollo</h2>
            <p class="small text-muted mb-0">
                Para ver más detalles del error durante la depuración local, configurá
                <code>ASPNETCORE_ENVIRONMENT</code> en <code>Development</code> y reiniciá la aplicación.
                En un entorno publicado, el modo de desarrollo puede exponer información de las excepciones.
            </p>
        </div>
    </div>
</section>
